; OpenAssault - 4. hadműveleti terület, magyar eligazítás (UTF-8)

[1]{OTT VAN - AZ IDEGENEK REJTETT GYÁRKOMPLEXUMA.}

[2]{SZERINTEM AZ IDEGENEK ELÉG IDEGESEK LESZNEK, HA ELKEZDJÜK A TŰZIJÁTÉKOT.}

[3]{AZ AH-23-ASODNAK ODABENT SZŰK LENNE A HELY.}

[4]{EZÉRT A T1-ET KELL HASZNÁLNOD: FORDULÉKONY, GYORS ÉS PÁNCÉLOZOTT.}

[5]{A FÜGGŐLEGES SUGÁRHAJTÓMŰVEINEK HÁLA A LEGHIHETETLENEBB MANŐVEREKRE IS KÉPES.}

[6]{FÉSÜLD ÁT A TERÜLETET. A MŰSZEREINK SZERINT VALAHOL A KÖZELBEN EGY ERŐS ENERGIAFORRÁSNAK KELL LENNIE.}

[7]{TALÁLD KI, HOGYAN TEHETED HARCKÉPTELENNÉ AZT AZ ÁTKOZOTT VALAMIT.}

[8]{KERESD MEG AZ ENERGIAFORRÁST, ÉS IKTASD KI.}

[9]{SZÉP MUNKA! CSAK ÍGY TOVÁBB. PUSZTÍTS EL MINDENT, AMI AZ UTADBA KERÜL.}

[10]{ROMBOLD LE AZ ÖSSZES ELLENSÉGES OBJEKTUMOT!}

[11]{A FENÉBE! A GENERÁTOROK PUSZTULÁSA BEOMLÁST OKOZOTT.}

[12]{LEHET, HOGY A TÖBBI KIJÁRAT IS HASZNÁLHATATLAN LETT. AKÁRMI TÖRTÉNT MÁSHOL, ERRE NEM JUTSZ KI}

[13]{KERESS KIUTAT! ROMBOLD LE AZ IDEGENEK MINDEN LÉTESÍTMÉNYÉT!}

[14]{ÚGY TŰNIK, EZ AZ EGYETLEN ÚT. NE HAGYD, HOGY AZ A TÚLMÉRETEZETT KONZERVDOBOZ FELTARTSON!}

[15]{VIGYÁZZ AZOKKAL A FÉNYSUGARAKKAL. KI TUDJA, MEKKORA KÁRT TESZNEK.}

[16]{TEDD TÖNKRE A ROBOTOT. KÜZDD ÁT MAGAD. VIGYÁZZ A FÉNYSUGARAKKAL.}

[17]{AZ A VALAMI ELŐTTED RENDKÍVÜL HALÁLOS MÉRGEZŐ ANYAG!}

[18]{KI KELL JUTNOD INNEN. NE ÉRJ HOZZÁ ANNAK A ZÖLD ANYAGNAK!}

[19]{HA KIJUTOTTÁL ERRŐL A TERÜLETRŐL, KERESD EZT A KIJÁRATOT.}

[20]{EZ VISSZAVISZ A JÓ IRÁNYBA.}

[21]{JUSS KI A TERÜLETRŐL, ÉS KERESD MEG A FELFELÉ VEZETŐ JÁRATOT.}

[22]{AKÁRMIÉRT IS ÉPÍTETTEK ILYEN BONYOLULT LABIRINTUST - NEKED KI KELL JUTNOD!}

[23]{ÉS EZ AZ EGYETLEN ÚT. HALADJ TOVÁBB, AMÍG ÚJ UTASÍTÁST NEM KAPSZ!}

[24]{KÜZDD ELŐRE MAGAD, AMÍG ÚJ UTASÍTÁST NEM KAPSZ.}

[25]{RENDBEN, JÓ MUNKA! AZ ENERGIAMEZŐ MÖGÖTT EGY RAKTÁRT TALÁLTUNK. ODABENT EZEKET A FURCSA SZERKEZETEKET GYÁRTJÁK.}

[26]{JUSS BE A TERÜLETRE, ÉS DÖNTSD ROMBA A HELYET.}

[27]{JUSS BE A RAKTÁRBA, ÉS DÖNTSD ROMBA.}

[28]{TE JÓ ÉG! A MŰSZEREINK SZERINT ITT BENT ERŐSEN MÉRGEZŐ A LEVEGŐ!}

[29]{EZ AZT JELENTI, HOGY EZEK A SZERKEZETEK A LÉGKÖR MEGVÁLTOZTATÁSÁRA SZOLGÁLNAK!}

[30]{HA EZ IGAZ, MINDENÁRON EL KELL PUSZTÍTANOD AZOKAT AZ ÁTKOZOTT VALAMIKET! AZ EGÉSZ EMBERISÉG SORSA FOROG KOCKÁN!}

[31]{SEMMISÍTS MEG MINDEN PÁROLOGTATÓT!}

[32]{JÓ, EGYELŐRE EZ ELÉG LESZ.}

[33]{EZ AZ ALAGÚT KIVISZ INNEN.}

[34]{ITT EGY TERMET LÁTSZ, BENNE KÉT GENERÁTORRAL ÉS EGY REPLIKÁCIÓS ÜZEMMEL.}

[35]{HA FELROBBANTOD A GENERÁTOROKAT, AZ A REPLIKÁCIÓS ÜZEMET IS ELSÖPRI.}

[36]{ROMBOLD LE A GENERÁTOROKAT, ÉS VELÜK A REPLIKÁCIÓS ÜZEMET!}

[37]{SZÉP MUNKA! ÚGY HISSZÜK, EZ MÖGÖTT A FÉMAJTÓ MÖGÖTT VAN AZ EGÉSZ KOMPLEXUM IRÁNYÍTÓKÖZPONTJA.}

[38]{MENJ ODA. HA MEGÉRKEZTÉL, ÚJRA JELENTKEZÜNK!}

[39]{JUSS EL AZ IRÁNYÍTÓKÖZPONT BEJÁRATÁHOZ.}

[40]{MENJ BE, ÉS TEDD A FÖLDDEL EGYENLŐVÉ AZ ÁTKOZOTT IRÁNYÍTÓKÖZPONTOT!}

[41]{SOK SZERENCSÉT!}

[42]{TEDD A FÖLDDEL EGYENLŐVÉ A KOMPLEXUM IRÁNYÍTÓKÖZPONTJÁT!}

[43]{HÉ, TÉNYLEG JÓ VAGY! EZ AZTÁN A TELJESÍTMÉNY, ÉS LEFOGADJUK, ALIG VÁROD, HOGY MEGNÉZD A KÖVETKEZŐ KÉT HADMŰVELETI TERÜLETET (5 ÉS 6).}

[44]{EHHEZ MÉG EGY SZINTET LÉPNED KELL, ÉS A "NEHÉZ" VAGY AZ "EXTRÉM" SZINT PILÓTÁJÁT KELL VÁLASZTANOD.}

[45]{DE EGY DOLOG BIZTOS: MEGVAN BENNED, AMI KELL, ÉS MOST MÁR NINCS VISSZAÚT. VÉGÜL VALAKINEK MEG KELL MENTENIE A FÖLDET, ÉS A FÖLD MEGÉRI - VAGY NEM ÍGY GONDOLOD?!}
