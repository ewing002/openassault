; OpenAssault - 3. hadműveleti terület, magyar eligazítás (UTF-8)

[0]{A MEGMENTETTEK KÖZÜL TÖBBEN ELMONDTÁK, HOGY AZ IDEGENEK FÖLD ALATTI ÜZEMEKBEN DOLGOZTATTÁK ŐKET.}

[1]{NEM LEHETÜNK BIZTOSAK BENNE, DE ÉRTESÜLÉSEINK SZERINT VALAHOL EZEN A VULKÁNI SZIGETEN KELL LENNIE EGY BEJÁRATNAK.}

[2]{REPÜLJ A PART FELÉ, ÉS FIGYELD AZ ELLENSÉGES TEVÉKENYSÉG JELEIT! KÖZBEN EGY MÁSIK HELIKOPTER A SZIGET TÖBBI RÉSZÉT DERÍTI FEL.}

[3]{VEDD ÁT AZ IRÁNYÍTÁST A PART FELETT, ÉS VÉDD A FELDERÍTŐ HELIKOPTERT!}

[4]{A FELDERÍTŐ HELIKOPTERÜNK LEZUHANT A KRÁTERBEN! MENJ ODA, ÉS NÉZD MEG, TÚLÉLTE-E A PILÓTA! JELENTKEZZ, HA MEGTALÁLTAD! ÉRTE MEGYÜNK.}

[5]{KERESD MEG A LEZUHANT PILÓTÁT!}

[6]{SZÉP MUNKA! AZONNAL KÜLDÜNK EGY MENTŐHELIKOPTERT, KIHOZZÁK A PILÓTÁT. TARTSD A POZÍCIÓDAT, ÉS FEDEZD A MENTŐKET.}

[7]{FEDEZD A MENTŐHELIKOPTERT!}

[8]{REPÜLJ A SZIGETRE, ÉS VIZSGÁLD MEG A KRÁTERT!}

[9]{KERESS EGY UTAT, AMELY A FÖLD ALATTI IDEGEN ÜZEMHEZ VEZET!}

[10]{TALÁLD MEG AZ UTAT AZ IDEGENEK GYÁRKOMPLEXUMÁHOZ!}

[11]{A PILÓTÁNK A ZUHANÁS ELŐTT EMLÍTETT EGY CSARNOKOT, AMIT A VULKÁNKRÁTER KÜLSŐ PEREMÉBE ÉPÍTETTEK. LEHET, HOGY ARRA JUTHATSZ BE.}

[12]{NÉZD MEG, ÉS TALÁLJ UTAT AZ ÜZEMBE!}

[13]{TALÁLD MEG AZ UTAT AZ IDEGENEK GYÁRKOMPLEXUMÁHOZ! TALÁLD MEG AZ UTAT AZ IDEGENEK GYÁRKOMPLEXUMÁHOZ!}

[14]{EZ AZ! REMEK, MOST ITT AZ IDŐ, HOGY BEFŰTSÜNK A VENDÉGEINKNEK.}

[15]{SEMMISÍTS MEG MINDEN ELLENSÉGES EGYSÉGET, ÉS HATOLJ MÉLYEBBRE A KOMPLEXUMBA! NE HAGYD, HOGY AZ A GÁT FELTARTSON. EGYSZERŰEN LŐJ RÁ LYUKAT!}

[16]{TALÁLD MEG AZ UTAT A KOMPLEXUM KÖZEPÉBE!}

[17]{ÚGY TŰNIK, EZT A KOMPLEXUMOT RÉG BEZÁRTÁK. CSAK ROZSDÁS VAS VAN ITT.}

[18]{A KÖRNYÉK TÖBBI SZIGETÉN FOLYTATJUK A KERESÉST.}

[19]{EGY PILLANAT... ÜZENETET KAPUNK EGY LEZUHANT POLGÁRI REPÜLŐGÉPRŐL. PÁR PERCE TÖRTÉNHETETT.}

[20]{TALÁN VALAKI TÚLÉLTE A BALESETET... KERESD MEG A ZUHANÁS HELYÉT, ÉS VÁRD A TOVÁBBI UTASÍTÁSOKAT!}

[21]{KERESD MEG A LEZUHANT REPÜLŐGÉPET!}

[22]{A RONCS ELÉG CSÚNYÁN NÉZ KI! REMÉLEM, TALÁLUNK MÉG TÚLÉLŐKET.}

[23]{VAN A KÖRNYÉKEN EGY BENNSZÜLÖTT FALU. NÉZZ KÖRÜL OTT! HÁTHA SZERENCSÉNK LESZ.}

[24]{KERESD MEG A BENNSZÜLÖTT FALUT, ÉS MENTSD KI A TÚLÉLŐKET!}

[25]{AZ EGÉSZ EGY ÁTKOZOTT CSAPDA VOLT! AZT HISZEM, MEGVAN A VÁLASZ ARRA, HOGY VANNAK-E IDEGENEK EZEN A SZIGETEN.}

[26]{A REJTEKHELYÜKNEK VALAHOL A LESZÁLLÓHELY KÖZELÉBEN KELL LENNIE. KERESD MEG A BÜDÖS LYUKUKAT, ÉS FÜSTÖLD KI A GAZEMBEREKET!}

[27]{KERESD MEG A REJTETT MENEDÉKET. SEMMISÍTS MEG MINDEN ELLENFELET!}

[28]{ÚGY TŰNIK, EGY EGYKORI FEGYVERRAKTÁRT TALÁLTUNK. SZÉP VOLT! BIZTOSAN JÓ NYOMON VAGYUNK!}

[29]{VIDD VISSZA A FEGYVERT A LESZÁLLÓHELYRE! EGY CSAPAT TUDÓS VÁR OTT, HOGY MEGVIZSGÁLJA.}

[30]{VIDD AZ IDEGEN FEGYVERT A LESZÁLLÓHELYRE! VÉDD A TUDÓSOKAT!}

[31]{ÚGY TŰNIK, BEKAPCSOLTÁL VALAMIFÉLE VÉDELMI RENDSZERT. NEM JUTSZ KI OLYAN KÖNNYEN, AHOGY BEJÖTTÉL.}

[32]{PRÓBÁLJ ÁTJUTNI A VÉDELMI RENDSZEREN, ÉS KIJUTNI A SZABADBA!}

[33]{GYŐZD LE A VÉDELMI RENDSZERT! NE ÉRJ HOZZÁ A MOZGÓ FALAKHOZ!}

[34]{NAGYON JÓ, MOST VAN MIN DOLGOZNIUK AZ EMBEREINKNEK. TALÁN MI MAGUNK IS HASZNÁLHATJUK AZT A FEGYVERRENDSZERT.}

[35]{TÉGY MÉG EGY BEVETÉST A KOMPLEXUMBAN, ÉS HATOLJ MÉLYEBBRE. AMIT TALÁLTUNK, AZ BIZTOSAN CSAK A KEZDET.}

[36]{DERÍTSD FEL A KOMPLEXUM MÉLYÉT!}

[37]{REMEK, SIKERÜLT! REPÜLJ ERRE A TALÁLKOZÁSI PONTRA! A FEGYVERT MEGVIZSGÁLÓ TUDÓSCSAPATTAL VÁRUNK.}

[38]{HA KELL, FEDEZD OTT AZ EMBEREINKET! SIESS, NINCS SOK IDŐ!}

[39]{REPÜLJ A MEGADOTT HELYRE! VÉDD A TUDÓSOKAT!}

[40]{REMEK, SIKERÜLT! REPÜLJ ERRE A TALÁLKOZÁSI PONTRA. KELLEMES MEGLEPETÉSSEL VÁRUNK.}

[41]{VIGYÁZZ, HOGY SEMMI BAJ NE ÉRJE A SZÁLLÍTÓHELIKOPTERT! SIESS ODA!}

[42]{REPÜLJ A TALÁLKOZÁSI PONTRA! FEDEZD A SZÁLLÍTÓHELIKOPTERT!}

[43]{A TUDÓSAINK MEGVIZSGÁLTÁK A TALÁLT FEGYVERT, ÉS ÁTALAKÍTOTTÁK. MOST MI IS HASZNÁLHATJUK.}

[44]{ENNEK A SZERKEZETNEK ELÉG NAGY AZ ÜTŐEREJE.}

[45]{VIDD MAGADDAL, ÉS NÉZD MEG, MEG TUDOD-E LEPNI AZ IDEGEN BARÁTAINKAT! BIZTOSAN MÉG MÉLYEBBRE HÚZÓDTAK A NYOMORÚSÁGOS LYUKUKBA.}

[46]{VEDD FEL A FIRE FLASH-T. FÉSÜLD ÁT A BARLANGRENDSZERT TOVÁBBI ELLENSÉGEKÉRT}

