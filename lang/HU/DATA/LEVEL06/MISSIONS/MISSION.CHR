; OpenAssault - 6. hadműveleti terület, magyar eligazítás (UTF-8)

[0]{A KÖVETKEZŐ KÜLDETÉSED TERÜLETE GRÖNLAND JÉGMEZŐIN VAN. VALAMIFÉLE ERŐS KISUGÁRZÁST FOGUNK ONNAN. ATTÓL TARTOK, MÉG NEM HALLOTTUNK AZ IDEGENEKRŐL AZ UTOLSÓ SZÓT!}

[1]{EZ AZ ALAGÚT AZ ENERGIAFORRÁSHOZ VEZET. KÖVESD AZ ALAGUTAT, ÉS HA ELLENSÉGBE ÜTKÖZÖL, TEDD MEG A SZÜKSÉGES LÉPÉSEKET!}
[2]{KÖVESD AZ ALAGUTAT A VÉGÉIG!}

[3]{SZÓVAL EZ VAN A MÉRÉSEINK MÖGÖTT: EGY GIGANTIKUS ERŐD! AKI ILYEN ERŐDÖT ÉPÍT, ANNAK NYOMÓS OKA VAN RÁ.}
[4]{PRÓBÁLJ ÁTJUTNI AZ ERŐDÖN. ÚGY TŰNIK, A SZOKÁSOS ENERGIAPAJZS VÉDI AZ ÁTJÁRÓT.}
[5]{VIGYÁZZ: NE HIDD, HOGY KÖNNYŰ LESZ! AZ ERŐDÖT ERŐSEN ŐRZIK!}
[6]{JUSS ÁT AZ ERŐD VÉDELMÉN!}

[7]{HÁT EZ NEM IGAZ! AZ ERŐD MÖGÖTT CSAK EGY NYÍLT JÉGMEZŐ VAN. SOKKAL TÖBBRE SZÁMÍTOTTUNK...}
[8]{VÁRJ EGY PILLANATOT! VÉSZJELZÉST FOGUNK!}
[9]{EGY HALÁSZHAJÓT MEGTÁMADTAK! A LEGÉNYSÉG LÁTOTT VALAMIT, AMIT AZ IDEGEN BARÁTAINK NAGYON SZERETTEK VOLNA TITOKBAN TARTANI.}
[10]{MENTSD MEG A HAJÓT A PUSZTULÁSTÓL!}

[11]{JÓ MUNKA! A HAJÓ LEGÉNYSÉGE KÖSZÖNI!}
[12]{A LEGÉNYSÉG SZERINT KORÁBBAN EGY NAGY REPÜLŐ TÁRGYAT IS LÁTTAK, BENTEBB A SZÁRAZFÖLD FELETT. TALÁN EZ A NYOM SEGÍT MEGTALÁLNI A FŐHADISZÁLLÁSUKAT.}
[13]{ÚJABB RÁDIÓÜZENET! A KÖZELI KUTATÓÁLLOMÁSAINK EGYIKÉT TÁMADÁS ÉRTE!}
[14]{EGY EGÉSZ HADOSZTÁLY TÁMADJA ŐKET! ALIG VAN OTT VÉDELMÜNK!}
[15]{SEGÍTS VISSZAVERNI A TÁMADÁST! NE HAGYD, HOGY LEROMBOLJÁK A KÉT BÁZISÉPÜLETET!}
[16]{ÉS SZÉTLŐDD A KÉT ROMBOLÓT IS!}
[17]{VÉDD MEG AZ ÁLLOMÁS ÉPÜLETEIT, ÉS SEMMISÍTSD MEG A ROMBOLÓKAT.}

[18]{ÚJRA VAN RÁDIÓKAPCSOLATUNK A KUTATÓÁLLOMÁSSAL. AZ IDEGENEK OKOZTA KÁRT KIJAVÍTOTTÁK. AZ ÁLLOMÁS SZERINT BENTEBB A SZÁRAZFÖLDÖN IDEGEN TEVÉKENYSÉG FOLYIK!}
[19]{ÜLJ BE A HARCKOCSIBA, ÉS INDULJ ARRA. KELJ ÁT A JÉGTÁBLÁKON, ÉS FIGYELD TOVÁBB A TERÜLETET!}
[20]{HAJTS BEFELÉ, ÉS FIGYELD AZ ELLENSÉGES TEVÉKENYSÉGET!}

[21]{MI A FENE EZ?! AZ IDEGENEK EGY EGÉSZ VÁROST ÉPÍTENEK!}
[22]{KELL MÉG EGY KIS IDŐ, HOGY A TUDÓSOK ELEMEZNI TUDJÁK AZ ADATOKAT!}
[23]{PRÓBÁLD MEG EGY IDEIG LEKÖTNI A BARÁTAINK FIGYELMÉT!}
[24]{SEMMISÍTS MEG MINDEN ELLENSÉGET A KÜLDETÉS TERÜLETÉN.}

[25]{EBBŐL AZ ÉPÜLETBŐL NAGY ENERGIAKIBOCSÁTÁST MÉRÜNK. VALÓSZÍNŰLEG ERŐMŰ.}
[26]{PRÓBÁLJ BETÖRNI, ÉS IKTASD KI AZT AZ ÁTKOZOTT ERŐMŰVET.}
[27]{SZABOTÁLD EL AZ ERŐMŰVET.}

[28]{REMEK MUNKA! EZ BIZTOSAN VISSZAVETI AZ ÉPÍTKEZÉSI TERVEIKET!}
[30]{A MŰSZEREINK ÚJ TEVÉKENYSÉGET ÉSZLELNEK A TERÜLETEN. HŰHA! VALAMI NAGYON NAGY KAPCSOLT BE EMÖGÖTT A FÉMFAL MÖGÖTT!}
[31]{MIELŐTT ODAVIHETNÉNK A KÜLDETÉSHEZ SZÜKSÉGES HELIKOPTERT, AZ ÖSSZES ELLENSÉGES LÉTESÍTMÉNYT EL KELL PUSZTÍTANOD.}

[32]{RENDBEN, A HELIKOPTER ÚTON VAN.}
[33]{MOST LÁSSUK, MI VAN A GÁT MÖGÖTT!}
[34]{AZ ANYJÁT! MI A FENE EZ? HATALMAS!}
[35]{EZ CSAK AZ IDEGENEK ANYAHAJÓJA LEHET!}
[36]{EDDIG MINDEN HELYZETET MEGOLDOTTÁL, AMIT AZ IDEGENEK ELÉD GÖRDÍTETTEK!}
[37]{TALÁLJ MÓDOT ARRA, HOGY LEHOZD AZT A NAGY DÖGÖT! LÁSSUK, HOGY HEVERIK KI EZT A SZEMETEK!}

[39]{REMEK MUNKA! A TE ERŐFESZÍTÉSEIDNEK HÁLA VÉGLEG MEGSZABADÍTOTTUK A FÖLDET EZEKTŐL A FÉRGEKTŐL.}
[40]{EZÉRT KITÜNTETÉST ÉRDEMELSZ.}
[41]{GRATULÁLOK! VÉGE.}
